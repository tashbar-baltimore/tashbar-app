/* v79 (2026-11-12, Head of School: "Put the Tashbar logo on all the pages"). The school logo, added to every page by tlTheme_ (Look.js).
   A small white plaque with the logo is put at the start of the page's first <header>. The sign-in screen keeps its own big logo (HomePage.html).
   Looks only: if anything fails, the page shows as before. */
/* v154 (HoS 2026-11-13, "a sweet retake of schooling"): the Tashbar honey brand. A honey dipper pours a golden Aleph (Kodesh) and a little Latin A (Chol)
   on a deep navy app tile, after the minhag of honey on the Aleph-Beis on a child's first day of learning. v155: a full, clear Aleph (Frank Ruhl Libre) and the wordmark in the style of the original school logo
   (TASHBAR in classic serif capitals, תשב"ר and BALTIMORE with gold rules) + "Learning that tastes sweet". Source SVG, PNG and a 512 px app icon are in HQ "12 BRAND". The old school logo is in v153 and earlier. */
var TL_LOGO_URL = 'data:image/png;base64,';
function tlLogoTag_() {
  return '<style id="tl-logo-css">.tl-logo{display:inline-flex;align-items:center;justify-content:center;flex:none;align-self:center;background:#fff;border-radius:12px;padding:4px 9px;height:46px;box-sizing:border-box;box-shadow:0 2px 10px rgba(0,0,0,.18),0 0 0 2px #E8C26A;margin:0 12px 0 0;order:-1}'
    + '.tl-logo img{height:38px;width:auto;display:block}@media(max-width:560px){.tl-logo{height:36px;padding:3px 6px;margin-right:8px}.tl-logo img{height:30px}}</style>'
    + '<script>window.TL_LOGO=window.TL_LOGO||' + JSON.stringify(TL_LOGO_URL) + ';(function(){var q=0;function put(){q=0;try{var h=document.querySelector("header");if(!h||h.querySelector(".tl-logo")||h.closest("[hidden]"))return;'
    + 'var s=document.createElement("span");s.className="tl-logo";s.innerHTML=\'<img alt="Tashbar of Baltimore">\';s.firstChild.src=window.TL_LOGO;h.insertBefore(s,h.firstChild);}catch(e){}}'
    + 'function soon(){if(!q){q=1;requestAnimationFrame(put);}}document.addEventListener("DOMContentLoaded",function(){put();try{new MutationObserver(soon).observe(document.body,{childList:true,subtree:true});}catch(e){}});})();<\/script>';
}
