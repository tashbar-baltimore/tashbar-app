  put_('Settings',{id:'backup:'+uid_('sentence-studio'),value:backup,at:now_()},u.id);
  put_('Curriculum',{
   id:raw.sourceId,title:TashbarSentenceStudio.source.sourceTitle,subject:'Language Arts',status:'draft',version:1,
   source:{fileId:TashbarSentenceStudio.source.fileId,rootId:TashbarSentenceStudio.source.rootId,physicalPages:'2-4',license:'Reuse rights not established; original activities only; do not redistribute PDF.'},
   needsAuthoring:false,stagingTestReady:true,studentPagesChecked:true
  },u.id);
