function secret_(){const p=PropertiesService.getScriptProperties();let s=p.getProperty('TL_AUTH_SECRET');if(!s){s=Utilities.getUuid()+Utilities.getUuid()+Utilities.getUuid();p.setProperty('TL_AUTH_SECRET',s);}return s;}
function digest_(s){return Utilities.base64EncodeWebSafe(Utilities.computeHmacSha256Signature(String(s),secret_())).replace(/=+$/,'');}
function constantEqual_(a,b){a=String(a||'');b=String(b||'');let v=a.length^b.length;for(let i=0;i<Math.max(a.length,b.length);i++)v|=(a.charCodeAt(i)||0)^(b.charCodeAt(i)||0);return v===0;}
function randomCode_(length){const alphabet='ABCDEFGHJKLMNPQRSTUVWXYZ23456789';const bytes=Utilities.computeHmacSha256Signature(Utilities.getUuid()+Utilities.getUuid()+now_(),secret_());return Array.from({length:length},(_,i)=>alphabet[(bytes[i%bytes.length]+256)%32]).join('');}
function createAuthTables_(){const db=db_();['Credentials','Sessions','Throttle','Observations'].forEach(name=>{if(!db.getSheetByName('TL '+name)){const s=db.insertSheet('TL '+name);s.getRange(1,1,1,4).setValues([['Record ID','Record JSON','Updated at (UTC)','Updated by']]).setFontWeight('bold').setBackground('#123b46').setFontColor('#ffffff');s.setFrozenRows(1);s.setColumnWidth(1,250);s.setColumnWidth(2,600);s.setColumnWidth(3,190);s.setColumnWidth(4,180);}});}
function installPersonalCodes(){const who=owner_();return locked_(()=>{createAuthTables_();secret_();if(setting_('codeAccessReady')!==true)put_('Settings',{id:'codeAccessReady',value:true},who);if(setting_('portalPublic')==null)put_('Settings',{id:'portalPublic',value:false},who);console.log('Personal-code authentication installed. Anonymous users receive only the login page. Existing deployment permissions remain unchanged.');});}
function publicInfo_(){return {version:TL.version,ownerAvailable:String(Session.getActiveUser().getEmail()||'').toLowerCase()===TL.owner,testing:setting_('testing')===true,school:'Tashbar Learning',sessionHours:2};}
function credentialView_(c){return {id:c.id,name:c.name,role:c.role,studentId:c.studentId||'',groups:c.groups||[],active:!!c.active,demo:!!c.demo,version:c.version,createdAt:c.createdAt,rotatedAt:c.rotatedAt||''};}
function credentialsForAdmin_(){return rows_('Credentials').map(credentialView_);}
function issueCode_(u,p){requireRole_(u,['admin']);return locked_(()=>{let id=String(p.id||'').trim().toUpperCase();const role=p.role;if(!['student','teacher','admin'].includes(role))throw Error('Choose a valid role.');let name=text_(p.name,160),studentId='';let groups=[];if(role==='student'){studentId=String(p.studentId||'');const s=get_('Students',studentId);if(!s||!s.active)throw Error('Choose an active student.');id=studentId.toUpperCase();name=s.name;}else{if(!name.trim())throw Error('Staff name is required.');id=id||('STAFF'+Utilities.getUuid().replace(/-/g,'').slice(0,10).toUpperCase());groups=Array.from(new Set(p.groups||[]));if(groups.some(g=>!get_('Groups',g)))throw Error('Choose valid staff groups.');}if(!/^[A-Z0-9_-]{2,80}$/.test(id))throw Error('Invalid access ID.');if(rows_('Credentials').some(c=>c.id!==id&&c.id.replace(/-/g,'')===id.replace(/-/g,'')))throw Error('This access ID conflicts with an existing ID. Choose another.');const old=get_('Credentials',id);if(old&&(old.role!==role||old.studentId!==studentId))throw Error('This access ID already belongs to another principal.');const raw=randomCode_(role==='student'?16:24);const c={id:id,name:name,role:role,studentId:studentId,groups:groups,active:true,demo:role==='student'?/^DEMO-/.test(studentId):!!p.demo,hash:digest_(id+'.'+raw),version:old?old.version+1:1,createdAt:old?old.createdAt:now_(),rotatedAt:now_()};put_('Credentials',c,u.id);audit_(u.id,old?'rotate-code':'issue-code',id);return {credential:credentialView_(c),code:id+'.'+raw.match(/.{1,4}/g).join('-'),notice:'Record this code now. It cannot be retrieved later. Reissuing it revokes prior codes and sessions.'};});}
function toggleCode_(u,p){requireRole_(u,['admin']);return locked_(()=>{const c=get_('Credentials',p.id);if(!c)throw Error('Access record not found.');c.active=p.active===true;c.version++;put_('Credentials',c,u.id);audit_(u.id,c.active?'enable-code':'revoke-code',c.id);return credentialView_(c);});}
function throttle_(key,limit,windowMs,increment){const at=Date.now();let r=get_('Throttle',key);if(!r||at-r.start>=windowMs)r={id:key,start:at,count:0};if(r.count>=limit)throw Error('Too many sign-in attempts. Wait 15 minutes or ask the administrator to reset access.');if(increment){r.count++;put_('Throttle',r,'auth');}return r;}
function loginCode_(p){return locked_(()=>{if(setting_('codeAccessReady')!==true)throw Error('Code access is not installed.');const value=text_(p.code,180).trim().toUpperCase().replace(/[\s-]/g,'');const dot=value.indexOf('.');const suppliedId=dot>0?value.slice(0,dot):'';const validId=/^[A-Z0-9_]{2,80}$/.test(suppliedId);const candidates=validId?rows_('Credentials').filter(c=>c.id.replace(/-/g,'')===suppliedId):[];const c=candidates.length===1?candidates[0]:null;const key='login:'+(c?c.id:'unknown');throttle_('global-failures',600,900000,false);throttle_(key,c?8:40,900000,false);const expected=c?c.hash:digest_('invalid');const raw=dot>0?value.slice(dot+1):'';const actual=digest_((c?c.id:suppliedId)+'.'+raw);const matched=constantEqual_(actual,expected);if(!c||!c.active||!matched){throttle_('global-failures',600,900000,true);throttle_(key,c?8:40,900000,true);throw Error('The personal code was not recognized or access is inactive.');}if(setting_('testing')===true&&!c.demo)throw Error('The portal is in restricted testing. Real-student code access is not released.');const u=principalFromCredential_(c);const token=Utilities.getUuid()+Utilities.getUuid()+Utilities.getUuid(),id='session:'+digest_(token),at=Date.now();put_('Sessions',{id:id,credentialId:c.id,credentialVersion:c.version,active:true,createdAt:at,expiresAt:at+2*60*60*1000},c.id);put_('Throttle',{id:key,start:at,count:0},'auth');audit_(c.id,'code-login',c.id);return {token:token,expiresAt:at+2*60*60*1000,user:{id:u.id,name:u.name,role:u.role},testing:setting_('testing')===true};});}
function principalFromCredential_(c){if(!c||!c.active)throw Error('Access is inactive.');const u={id:'code:'+c.id,name:c.name,role:c.role,studentId:c.studentId||'',groups:c.groups||[],demo:!!c.demo,owner:false,credentialId:c.id};if(u.role==='student'){const s=get_('Students',u.studentId);if(!s||!s.active)throw Error('Student access is inactive.');}return u;}
function sessionUser_(token){token=text_(token,200);if(token.length<50)throw Error('Sign in with your personal code.');const s=get_('Sessions','session:'+digest_(token));if(!s||!s.active||s.expiresAt<=Date.now())throw Error('Your session has ended. Sign in again.');const c=get_('Credentials',s.credentialId);if(!c||!c.active||c.version!==s.credentialVersion)throw Error('Your code was changed or access was revoked. Sign in again.');if(setting_('testing')===true&&!c.demo)throw Error('Real-student access is not released.');return principalFromCredential_(c);}
function logoutCode_(token){if(!token)return {signedOut:true};return locked_(()=>{const s=get_('Sessions','session:'+digest_(text_(token,200)));if(s){s.active=false;put_('Sessions',s,'logout');}return {signedOut:true};});}
function authDispatch_(u,req){if(req.action==='studentReport')return studentReport_(u,req.payload||{});if(req.action==='recordObservation')return recordObservation_(u,req.payload||{});if(req.action==='issueCode')return issueCode_(u,req.payload||{});if(req.action==='toggleCode')return toggleCode_(u,req.payload||{});if(req.action==='resetLoginAttempts'){requireRole_(u,['admin']);return locked_(()=>{const id=text_(req.payload.id,80);put_('Throttle',{id:'login:'+id,start:Date.now(),count:0},u.id);audit_(u.id,'reset-login-attempts',id);return {reset:true};});}return dispatch_(u,req);}
function portalApi_(req){if(!req||typeof req!=='object')throw Error('Invalid request.');if(req.action==='publicInfo')return publicInfo_();if(req.action==='loginCode')return loginCode_(req.payload||{});if(req.action==='logoutCode')return logoutCode_(req.token);let u;if(req.token){u=sessionUser_(req.token);if(req.persona&&req.persona!=='owner')throw Error('Personal-code sessions cannot impersonate another user.');}else if(req.ownerMode===true){u=identity_(Session.getActiveUser().getEmail(),req.persona);}else throw Error('Sign in with your personal code.');return authDispatch_(u,req);}
function runCodeAccessTests(){owner_();const results=[];function test(name,fn){try{fn();results.push({name:name,result:'PASS'});}catch(e){results.push({name:name,result:'FAIL',detail:String(e.message)});}}function assert(x,m){if(!x)throw Error(m||'Assertion failed');}function deny(fn){let yes=false;try{fn();}catch(e){yes=true;}assert(yes,'Expected access denial');}const admin=identity_(TL.owner);let ca,cb,ct,sa,sb,st;test('Authentication tables installed',()=>{createAuthTables_();secret_();put_('Settings',{id:'codeAccessReady',value:true},'TEST');});
test('Public info excludes roster and credentials',()=>{const p=portalApi_({action:'publicInfo'});assert(!p.students&&!p.accounts&&!p.credentials);});test('Anonymous bootstrap denied',()=>deny(()=>portalApi_({action:'bootstrap'})));test('Client role or student ID cannot authenticate',()=>deny(()=>portalApi_({action:'bootstrap',payload:{role:'admin',studentId:'DEMO-01'}})));test('Issue fictional student and teacher codes',()=>{ca=issueCode_(admin,{role:'student',studentId:'DEMO-01'});cb=issueCode_(admin,{role:'student',studentId:'DEMO-02'});ct=issueCode_(admin,{id:'TEST-TEACHER',role:'teacher',name:'Fictional Teacher',groups:['PILOT-45'],demo:true});});test('No plaintext codes in credential records',()=>{assert(!JSON.stringify(rows_('Credentials')).includes(ca.code.split('.').pop().replace(/-/g,'')));assert(rows_('Credentials').every(c=>!c.code&&!c.token));});test('Incorrect personal code denied',()=>deny(()=>loginCode_({code:'DEMO-01.AAAA-BBBB-CCCC-DDDD'})));test('Student and teacher login by personal code',()=>{sa=loginCode_({code:ca.code});sb=loginCode_({code:cb.code});st=loginCode_({code:ct.code});assert(sa.token&&sb.token&&st.token);});test('Personal-code session has only own student record',()=>{const d=portalApi_({action:'bootstrap',token:sa.token});assert(d.students.length===1&&d.students[0].id==='DEMO-01');assert(!d.credentials&&!d.accounts&&!d.profiles);});test('Code student cannot read another student',()=>deny(()=>portalApi_({action:'openWork',token:sa.token,payload:{assignmentId:'DEMO-WP-DEMO-02'}})));test('Code student cannot use owner test selector',()=>deny(()=>portalApi_({action:'bootstrap',token:sa.token,persona:'DEMO-02'})));test('Code student cannot issue codes',()=>deny(()=>portalApi_({action:'issueCode',token:sa.token,payload:{role:'admin',name:'Forged admin'}})));test('Code teacher cannot issue codes',()=>deny(()=>portalApi_({action:'issueCode',token:st.token,payload:{role:'student',studentId:'DEMO-01'}})));test('Session tokens are hashed in storage',()=>assert(!JSON.stringify(rows_('Sessions')).includes(sa.token)));test('Modified session token denied',()=>deny(()=>sessionUser_(sa.token+'x')));test('Rotation revokes old code and session',()=>{ca=issueCode_(admin,{role:'student',studentId:'DEMO-01'});deny(()=>sessionUser_(sa.token));sa=loginCode_({code:ca.code});});test('Logout revokes session on server',()=>{logoutCode_(sa.token);deny(()=>sessionUser_(sa.token));});test('Expired sessions denied',()=>{const s=get_('Sessions','session:'+digest_(sb.token));s.expiresAt=Date.now()-1;put_('Sessions',s,'TEST');deny(()=>sessionUser_(sb.token));});test('Disabled access revokes current sessions',()=>{toggleCode_(admin,{id:'TEST-TEACHER',active:false});deny(()=>sessionUser_(st.token));deny(()=>loginCode_({code:ct.code}));});test('Attempt limits enforced',()=>{put_('Throttle',{id:'login:DEMO-02',start:Date.now(),count:8},'TEST');deny(()=>loginCode_({code:cb.code}));put_('Throttle',{id:'login:DEMO-02',start:Date.now(),count:0},'TEST');});
results.forEach(r=>put_('Tests',{id:uid_('auth-test'),at:now_(),name:r.name,result:r.result,detail:r.detail||'',scope:'Personal-code server authentication tests with fictional accounts.'},'TEST'));console.log(JSON.stringify(results));console.log('Code-access tests: '+results.filter(r=>r.result==='PASS').length+'/'+results.length+'. Codes are never printed in test logs.');return results;}

function studentReport_(u,p){requireRole_(u,['teacher','admin']);studentAllowed_(u,p.studentId);const s=get_('Students',p.studentId),assignments=rows_('Assignments').filter(a=>a.studentId===s.id&&a.active),works=rows_('Work').filter(w=>w.studentId===s.id),history=rows_('History');const items=assignments.map(a=>{const w=works.find(w=>w.assignmentId===a.id),l=get_('Lessons',a.lessonId);return {assignmentId:a.id,day:a.day||'',lesson:a.title,source:l?{fileId:l.sourceId,pages:l.pages}:null,status:w?w.status:'not_started',submittedAt:w?w.submittedAt||'':'',updatedAt:w?w.updatedAt:'',feedback:w?w.feedback:'',support:w?w.support:'',observations:w?w.observations||{}:{},activitySeconds:w?w.activitySeconds||0:0,submissions:history.filter(h=>h.assignmentId===a.id&&h.kind==='submission').length};});return {student:{id:s.id,name:s.name},generatedAt:now_(),generatedBy:u.id,items:items,observations:rows_('Observations').filter(o=>o.studentId===s.id),summary:{assigned:items.length,submitted:items.filter(i=>i.status==='submitted').length,reviewed:items.filter(i=>i.status==='reviewed').length,revisionRequested:items.filter(i=>i.status==='revision_requested').length},limits:'Evidence summary, not a report-card grade, diagnosis, placement or standardised assessment. Session activity is a client-estimated amount of active portal time, not reading speed or ability.'};}
function recordObservation_(u,p){requireRole_(u,['teacher','admin']);studentAllowed_(u,p.studentId);const source=get_('Curriculum',p.sourceId);if(!sourceAllowed_(p.sourceId)||(!source&&!/^\d+(\s*[-,]\s*\d+)*$/.test(String(p.pages)))||(source&&!String(p.pages||'').trim()))throw Error('Choose an approved source and exact page or section locator for this observation.');if(!['independent','verbal prompt','model','full support','not recorded'].includes(p.support))throw Error('Choose the support observed.');const row={id:uid_('observation'),studentId:p.studentId,at:now_(),skill:text_(p.skill,200),evidence:text_(p.evidence,4000),nextStep:text_(p.nextStep,1500),support:p.support,sourceId:p.sourceId,pages:text_(p.pages,80),teacher:u.id};if(!row.skill.trim()||!row.evidence.trim())throw Error('Record an observed skill and the evidence.');return locked_(()=>{put_('Observations',row,u.id);audit_(u.id,'record-observation',row.id);return row;});}

