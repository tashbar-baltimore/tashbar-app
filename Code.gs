  draft.topic='Sentences and Questions';draft.difficulty=1;
  draft.prerequisites=['Read short sentences with support','Identify letters and basic punctuation'];
  draft.objective='Recognize complete sentences, statements and questions; write with capitals and end marks.';
  draft.estimatedMinutes=20;draft.teacherReviewRequired=true;
  draft.sourceTitle=TashbarSentenceStudio.source.sourceTitle;
  draft.sentenceStudioTemplate='sentence-studio-v1';
